# Django API base, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public URL of this storefront (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where catalogue, cart and checkout data come from:
#   mock - built-in sample catalogue, browser-side cart and simulated checkout (no backend needed)
#   api  - the Django API (needs the products, checkout and payments endpoints)
# Auth and the account area always use the API.
NEXT_PUBLIC_DATA_SOURCE=mock

# Shop's WhatsApp Business number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=233200000000
